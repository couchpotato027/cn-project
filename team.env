# =====================================================================
#  CN Project – Private Network Service Platform
#  THE ONLY FILE YOU NORMALLY EDIT.
#
#  Every script and every generated config (dnsmasq, nginx, pf firewall)
#  reads its values from here. After editing, run:   ./scripts/render.sh
#  Keep this file IDENTICAL on every laptop of the team.
# =====================================================================

# --- Team identity -----------------------------------------------------
# Use the team number your faculty gave you. Domain becomes app.<TEAM_ID>.test
TEAM_ID=team67
DOMAIN="${TEAM_ID}.test"

# --- Physical laptops (fill in after running ./scripts/network-info.sh) -
# Laptop 1 – Priyansh
LAPTOP1_IP=10.7.19.6
# Laptop 2 – Bhavay
LAPTOP2_IP=10.7.27.44
# Laptop 3 – Nishant
LAPTOP3_IP=10.7.23.55

# =====================================================================
#  ROLE MAP – which laptop plays which role.
#  CURRENT LAYOUT: 3 MEMBERS
#    Laptop 1 (Priyansh) = Mac 1 : Primary DNS + Test Client
#    Laptop 2 (Bhavay)   = Mac 2 + Mac 4 : Edge nginx + Backend B
#    Laptop 3 (Nishant)  = Mac 3 : Backend A
#                          + Backup DNS (Ext A) + Standby Edge (Ext E)
#  Other layouts (2 or 4 members): docs/04-TEAM-SPLIT.md
#  (you only change the lines below – nothing else).
# =====================================================================
DNS_PRIMARY_IP="${LAPTOP1_IP}"
DNS_BACKUP_IP="${LAPTOP3_IP}"
EDGE_IP="${LAPTOP2_IP}"
EDGE_STANDBY_IP="${LAPTOP3_IP}"
BACKEND_A_IP="${LAPTOP3_IP}"
BACKEND_B_IP="${LAPTOP2_IP}"

# --- 4-member layout (uncomment when you have 4 laptops) ----------------
# LAPTOP4_IP=192.168.1.13      # Member 4
# DNS_PRIMARY_IP="${LAPTOP1_IP}"
# DNS_BACKUP_IP="${LAPTOP4_IP}"
# EDGE_IP="${LAPTOP2_IP}"
# EDGE_STANDBY_IP="${LAPTOP3_IP}"
# BACKEND_A_IP="${LAPTOP3_IP}"
# BACKEND_B_IP="${LAPTOP4_IP}"

# --- Ports --------------------------------------------------------------
BACKEND_A_PORT=3001
BACKEND_B_PORT=3002
# If your Mac refuses 80/443, set 8080/8443 (allowed by the project rules).
HTTP_PORT=80
HTTPS_PORT=443
DNS_PORT=53

# --- DNS behaviour ------------------------------------------------------
# TTL (seconds) handed out for project records. Short so Ext B / Ext E are visible.
DNS_TTL=30
# Where dnsmasq forwards NON-project names (google.com etc.) so internet still works.
UPSTREAM_DNS=1.1.1.1

# GENERATED by scripts/render.sh from templates/dnsmasq.conf.tmpl - do not edit by hand.
# Role: {{DNS_ROLE}} DNS server for {{DOMAIN}}   (Task B / Extension A)

# --- Where to listen ---------------------------------------------------
port={{DNS_PORT}}
# Only listen on the LAN address of this laptop and on loopback.
listen-address={{LISTEN_IP}}
listen-address=127.0.0.1
bind-interfaces

# --- Our private zone ----------------------------------------------------
# Answer *.{{DOMAIN}} ourselves and NEVER forward it to the internet.
local=/{{DOMAIN}}/
# The actual A records live in a hosts-style file so they can be changed live
# (Extension B / E) with a SIGHUP instead of a full restart.
no-hosts
addn-hosts={{RECORDS_FILE}}
# TTL handed to clients for those records. dnsmasq's default is 0 (= "don't
# cache"), which would make the TTL experiments impossible.
local-ttl={{DNS_TTL}}

# --- Everything else (google.com, apple.com ...) -------------------------
# Forward to a public resolver so laptops that use us still have internet.
no-resolv
server={{UPSTREAM_DNS}}
domain-needed
bogus-priv

# --- Evidence ----------------------------------------------------------
# Print every query and answer to the terminal - great for the live demo.
log-queries
